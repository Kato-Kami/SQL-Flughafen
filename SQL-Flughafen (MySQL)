-- Tabellen für den Flughafen, die Fluglinie, das Flugzeug, den Flug, sowie fuer die Flugetappe
CREATE TABLE Airport (
    AirportCode VARCHAR(10) PRIMARY KEY,
    AirportName VARCHAR(50),
    AirportLocation VARCHAR(50),
    Country VARCHAR(50)
);

CREATE TABLE Airline (
    AirlineCode INTEGER PRIMARY KEY,
    AirlineName VARCHAR(50)
);

CREATE TABLE Airplane (
    ID INTEGER PRIMARY KEY,
    Manufacturer VARCHAR(50),
    Airspeed FLOAT,
    Motor VARCHAR(50),
    Airline INTEGER REFERENCES Airline(AirlineCode)
);

CREATE TABLE Flight (
    FlightNumber INTEGER PRIMARY KEY,
    Airline INTEGER REFERENCES Airline(AirlineCode),
    Airplane VARCHAR(50) REFERENCES Airplane(ID)
);

CREATE TABLE Leg (
    LegID INTEGER PRIMARY KEY,
    Flight VARCHAR(30) REFERENCES Flight(FlightNumber),
    DepartureAirport VARCHAR(30) REFERENCES Airport(AirlineCode),
    DestinationAirport VARCHAR(30) REFERENCES Airport(AirportCode),
    DepartureTime TIME,
    ArrivalTime TIME

);

